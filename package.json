{
  "name": "transporter",
  "version": "0.1.0",
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2"
  },
  "private": true,
  "scripts": {
    "dev": "bun run --parallel --filter '*' dev",
    "build": "bun run --filter app build && bun run --filter api build && bun run copy-static",
    "copy-static": "rm -rf api/dist/static && cp -r app/build api/dist/static",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typescript": "bun run --filter '*' typescript",
    "release": "semantic-release"
  },
  "type": "module",
  "workspaces": ["app", "api"]
}
