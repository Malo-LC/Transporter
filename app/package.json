{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.3.0",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@mui/system": "^9.3.0",
    "@mui/x-date-pickers": "^9.11.0",
    "browser-user-session": "1.0.5",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.22",
    "micro-observables": "^1.7.2",
    "plume-ts-di": "^1.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-hook-form-mui": "^9.0.1",
    "react-toastify": "^11.1.0",
    "simple-http-request-builder": "^2.1.0",
    "simple-http-rest-client": "^2.3.0",
    "simple-job-scheduler": "^1.1.2",
    "simple-logging-system": "^1.1.0",
    "type-route": "^1.1.0",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@swc/core": "^1.16.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/validator": "^13.15.10",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.5",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "postcss": "^8.5.26",
    "sass": "^1.102.0",
    "swc-class-decorator-plugin": "^1.1.0",
    "typed-scss-modules": "^8.1.1",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "browserslist": [
    "defaults",
    "not IE 11",
    "not op_mini all",
    "Chrome >= 80",
    "Firefox >= 80",
    "safari >= 13"
  ],
  "scripts": {
    "dev": "concurrently \"bun run watch-scss-module\" \"bun run vite\"",
    "start": "bun run dev",
    "watch-scss-module": "typed-scss-modules 'src/**/*.scss' -w -u",
    "build": "rm -rf build && vite build",
    "typescript": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "check-scss-types": "typed-scss-modules 'src/**/*.scss' -l"
  }
}
